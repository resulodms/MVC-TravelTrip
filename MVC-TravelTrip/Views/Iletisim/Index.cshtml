@model MVC_TravelTrip.Models.Sinifler.Iletisim
@{
	ViewData["Title"] = "Index";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
	<style>
		#contactForm input,
		#contactForm textarea {
			width: 100%;
			padding: 12px;
			margin-bottom: 12px;
			border: 1px solid #ccc;
			border-radius: 6px;
			font-size: 14px;
			font-family: inherit;
			box-sizing: border-box;
			background: #fff;
		}

		#contactForm textarea {
			height: 160px;
			resize: vertical;
		}

		#contactForm input:focus,
		#contactForm textarea:focus {
			border-color: #3a8dde;
			outline: none;
		}

		#contactForm button {
			padding: 12px 30px;
			border: none;
			border-radius: 6px;
			background: #3a8dde;
			color: #fff;
			font-size: 15px;
			cursor: pointer;
		}

		#contactForm button:hover {
			background: #2a6db0;
		}

		@@media (max-width: 768px) {
			#contactForm .form,
			#contactForm .form1 {
				float: none;
				width: 100%;
			}
		}
	</style>
}

<div class="contact">

	<div class="contact">
		<div class="wrap">
			<div class="contact-top">
				<h3>İletişim Bilgileri</h3>
				<p>Sorularınız, önerileriniz ya da iş birliği talepleriniz için aşağıdaki formu doldurabilir veya iletişim bilgilerimden bana ulaşabilirsiniz.</p>
			</div>

			<form class="cmxform" id="contactForm" method="post" action="/Iletisim/Index">
				<div class="form">
					<div>
						<input type="text" class="textbox" name="AdSoyad" placeholder="Ad Soyad" required />
					</div>
					<div>
						<input type="email" class="textbox" name="Mail" placeholder="Email" required />
					</div>
					<div>
						<input type="text" class="textbox" name="Konu" placeholder="Konu" required />
					</div>
					
				</div>
				<div class="form1">
					<div>
						<textarea name="Mesaj" placeholder="Mesaj" required></textarea>
					</div>
					<div>
						<button type="submit" class="read">Gönder</button>
					</div>
				</div>
			</form>

			<div class="clear"></div>
			<div class="contact-bottom">
				<div class="contact-left">
					<div class="contact-add">
						<h3>İletişim</h3>
						<p>Numara:0552 996 00 00</p>
						<p>Email: <a href="mailto:resul.odmis@mail.com">resul.odmis@mail.com</a></p>
					</div>
					<div class="contact-add">
						<h3>2. Adres</h3>
						<p>Telephone:1-22-5555</p>
						<p>Fax:1-22-5555</p>
						<p>Email:<a href="mailto:signup@gmail.com">signup@mail.com</a></p>
					</div>
				</div>
				<div class="contact-map">
					<iframe src="https://maps.google.com/maps?q=Istanbul&output=embed"
							width="100%" height="250" style="border:0;"
							loading="lazy" title="Konum haritası"></iframe>
				</div>
				<div class="clear"></div>
			</div>
			<div class="clear"></div>
		</div>
	</div>
	</div>