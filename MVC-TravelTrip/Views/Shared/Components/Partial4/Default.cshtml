@using MVC_TravelTrip.Models.Sinifler
@model List<Blog>

<div class="padding1">
    <h4>En Beğendiğim Yerler</h4>

    <div class="box-left">
        @foreach (var x in Model.Take(3))
        {
            <div class="bot-img">
                <img src="@x.BlogImage" alt="@x.Baslik" style="width:100%; height:80px; object-fit:cover;" />
            </div>
            <div class="bot-desc">
                <p>@(x.Aciklama.Length > 80 ? x.Aciklama.Substring(0, 80) + "..." : x.Aciklama)</p>
            </div>
            <div class="clear"></div>
        }
    </div>

    <div class="box1-left">
        @foreach (var x in Model.Skip(3).Take(3))
        {
            <div class="bot-img">
                <img src="@x.BlogImage" alt="@x.Baslik" style="width:100%; height:80px; object-fit:cover;" />
            </div>
            <div class="bot-desc1">
                <p>@(x.Aciklama.Length > 80 ? x.Aciklama.Substring(0, 80) + "..." : x.Aciklama)</p>
            </div>
            <div class="clear"></div>
        }
    </div>
</div>
