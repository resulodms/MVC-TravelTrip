




<div class="content-form">
    <style>
        .content-form form input[type="email"] {
            padding: 10px 15px;
            width: 100%;
            color: #333;
            font-size: 1em;
            border: 1px solid #F6F1DE;
            font-family: 'Lato', sans-serif;
            outline: none;
            display: block;
            margin: 10px 0;
        }

        @@media (max-width: 480px) {
            .content-form form input[type="email"] {
                padding: 6px 10px;
                font-size: 0.8em;
            }
        }
    </style>
	<h3>Bir Yorum Yapın</h3>

    <form method="post" action="/Blog/Yorum">
        <input type="hidden" name="BlogId" value="@ViewBag.deger" />
        <input type="text" placeholder="Kullanıcı Adı" name="KullaniciAdi" required />
        <input type="email" placeholder="Mail Adresi" name="Mail" required />
        <textarea placeholder="Yorum" name="Yorum" required></textarea>
        <input type="submit" value="Gönder" />
    </form>

</div>