@using MVC_TravelTrip.Models.Sinifler
@model List<Blog>


<div class="con-bot">
    @foreach (var x in Model)
    {
        <div class="left">
            <div class="bot-left">
                <img src="@x.BlogImage" alt="" style="width:300px; height:120px; object-fit:cover;" />
            </div>
            <div class="left-text">
                <h4>@x.Baslik</h4>
                <span class="doller">@x.Tarih.ToString("dd.MM.yyyy")</span>
                <p style="height:45px; overflow:hidden;">
                    @x.Aciklama.Substring(0, Math.Min(x.Aciklama.Length, 80))
                </p>
                <p><a href="/Blog/BlogDetay/@x.Id"><span class="read"> Daha Fazlası</span></a></p>
            </div>

        </div>
    }
</div>


