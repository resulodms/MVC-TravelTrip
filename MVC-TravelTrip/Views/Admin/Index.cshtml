@using MVC_TravelTrip.Models.Sinifler
@model List<Blog>

@{
    ViewData["Title"] = "Bloglar";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h3>Blog Listesi </h3>
<br />
,   <div class="table-responsive">
<table class="table table-bordered">
 

    <tr>
        <th>Id</th>
        <th>Başlık</th>
        <th>Sil</th>
        <th>Güncelle</th>
        <th>Detaylar</th>
    </tr>
    @foreach (var x in Model)
    {
        <tr>
            <td>@x.Id</td>
            <td>@x.Baslik</td>
            <td><a href="/Admin/BlogSil/@x.Id" class="btn btn-danger"> Sil</a></td>
            <td><a href="/Admin/BlogGetir/@x.Id" class="btn btn-warning"> Güncelle</a></td>
            <td><a href="#" class="btn btn-default"> Detaylar</a></td>
            
        </tr>
    }
</table>
</div>
<a href="/Admin/YeniBlog" class="btn btn-primary">Yeni Blog</a>
