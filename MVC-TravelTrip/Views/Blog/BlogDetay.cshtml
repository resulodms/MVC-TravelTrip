@model MVC_TravelTrip.Models.Sinifler.BlogYorum

@{
	ViewData["Title"] = "BlogDetay";
	Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
	<link href="~/web1/css/bootstrap.css" rel="stylesheet" type="text/css" />
	<link href="~/web1/css/style.css" rel="stylesheet" type="text/css" />
}
	<div class="single">
		<div class="container">
			<div class="row">

				<div class="col-md-8 single-main">

					@foreach (var x in Model.Deger1)
					{
						<div class="single-grid">

							<img src="@x.BlogImage" alt="" style="margin-bottom:20px" />

							@x.Baslik

							<p>@x.Aciklama</p>

						</div>

						<br />
						<br />
					}
					@foreach (var y in Model.Deger2)
					{
						<ul class="comment-list">

							<li>
								<img src="~/web1/images/avatar.png" class="img-responsive" alt="">

								<div class="desc">
									<p>@y.KullaniciAdi : <br /> @y.Yorum</p>
								</div>

								<div class="clearfix"></div>
							</li>
							
						</ul>
					}
					@await Component.InvokeAsync("YorumPartial", new { id = Model.Deger1.First().Id })
					
				</div>

				<div class="col-md-4 side-content">

					<div class="recent">
						<h3>Son Bloglar</h3>
						@foreach (var z in Model.Deger3)
						{
							<ul>
								<li><a href="/Blog/BlogDetay/@z.Id">@z.Baslik </a></li>

							</ul>
						}

					</div>

					<div class="comments">

						<h3>Son Yorumlar</h3>

						<ul>
							<li><a href="#">Amada Doe</a> on <a href="#">Hello World!</a></li>
							<li><a href="#">Peter Doe</a> on <a href="#">Photography</a></li>
							<li><a href="#">Steve Roberts</a> on <a href="#">HTML5/CSS3</a></li>
						</ul>

					</div>

				</div>

			</div>
		</div>
	</div>
